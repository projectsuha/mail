{
  "name": "suha-foto",
  "productName": "Suha Foto",
  "version": "0.10.0",
  "description": "Suha Foto — çevrimdışı fotoğraf aracı",
  "author": "Sinan Erdoğan",
  "private": true,
  "main": "main.js",
  "scripts": { "start": "electron .", "dist": "electron-builder --win nsis --publish never" },
  "devDependencies": { "electron": "^44.0.0", "electron-builder": "^25.1.8" },
  "build": {
    "appId": "com.snnerdogan98.foto",
    "productName": "Suha Foto",
    "copyright": "Sinan Erdoğan",
    "files": ["main.js", "preload.js", "foto/**/*", "package.json"],
    "win": { "target": "nsis", "icon": "foto/simge/foto.ico" },
    "nsis": {
      "oneClick": false, "perMachine": false, "allowToChangeInstallationDirectory": true,
      "runAfterFinish": true, "createDesktopShortcut": true, "shortcutName": "Suha Foto",
      "installerLanguages": ["tr_TR"], "language": "1055",
      "artifactName": "Suha-Foto-Kurulum-${version}.exe"
    }
  }
}
