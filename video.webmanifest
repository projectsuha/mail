{
  "id": "./video.html",
  "name": "Video",
  "short_name": "Video",
  "description": "Cihazındaki videoları oynat: altyazı, hız, kaldığın yerden devam, ses yükseltme. Reklamsız, internetsiz.",
  "start_url": "./video.html",
  "scope": "./",
  "display": "standalone",
  "background_color": "#e8eaed",
  "theme_color": "#26282c",
  "icons": [
    {
      "src": "video-192.png?v=8",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "video-512.png?v=8",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "video-maskable.png?v=8",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "file_handlers": [
    {
      "action": "./video.html",
      "accept": {
        "video/*": [
          ".mp4",
          ".m4v",
          ".webm",
          ".mkv",
          ".mov"
        ]
      }
    }
  ]
}